# =============================================================================
# .env.example — placeholders only. Copy this file's VALUES into
# app/config/config.local.php (see below) — do NOT commit a real .env file.
# =============================================================================
#
# IMPORTANT — how this project actually reads these values:
#
# This codebase does NOT parse a .env file at runtime (no phpdotenv package
# is installed, and adding one now would be an unnecessary new dependency for
# something app/config/config.php already solves). Instead, app/config/
# config.php reads each of these as, in order:
#
#   1. app/config/config.local.php   (untracked, gitignored — see
#      app/config/config.local.php.example if present, or the format below)
#   2. a real server/OS environment variable via getenv('VAR_NAME')
#   3. a safe local-development default hard-coded in config.php
#
# So this .env.example exists purely to document the variable NAMES and to
# give you copy-paste-able values for whichever mechanism your host supports.
# On Hostinger, the simplest and most reliable option is (1): create
# app/config/config.local.php on the server (outside git) returning an array
# with these keys — see the template at the bottom of this file.
#
# =============================================================================

APP_ENV=local
# Set to "production" on Hostinger. This only affects error visibility
# (hides raw PHP errors/SQL from visitors and logs them instead) — it does
# NOT change any business logic.

# --- DATABASE (local XAMPP defaults shown) ---
DB_HOST=localhost
DB_NAME=capstone_db
DB_USER=root
DB_PASS=
DB_PORT=3306

# --- APPLICATION / API URLS (used by documentation and Flutter builds —
# the PHP app itself derives BASE_URL/SITE_URL automatically from the
# incoming request, so these are not read by config.php) ---
APP_URL=http://localhost/loyalty_managements
API_BASE_URL=http://localhost/loyalty_managements/api

# --- SECRETS (never put real values here — see app/config/config.local.php) ---
JWT_SECRET=replace_with_a_random_64_char_string
GEMINI_API_KEY=
SMTP_PASSWORD=

# --- WEBSOCKET (real-time chat push — optional; see README_DEPLOYMENT.md) ---
WS_HOST=127.0.0.1
WS_PORT=8080

# =============================================================================
# PRODUCTION EXAMPLE (placeholders only — put the real values in
# app/config/config.local.php on the Hostinger server, never in git):
#
# APP_ENV=production
# DB_HOST=YOUR_HOSTINGER_DB_HOST
# DB_NAME=YOUR_HOSTINGER_DB_NAME
# DB_USER=YOUR_HOSTINGER_DB_USER
# DB_PASS=YOUR_HOSTINGER_DB_PASSWORD
# APP_URL=https://YOUR_DOMAIN
# API_BASE_URL=https://YOUR_DOMAIN/api
# =============================================================================

# -----------------------------------------------------------------------------
# app/config/config.local.php TEMPLATE (copy this into that file on the
# server; it is already gitignored — do not remove it from .gitignore):
# -----------------------------------------------------------------------------
#
# <?php
# return [
#     'APP_ENV'        => 'production',
#     'DB_HOST'        => 'YOUR_HOSTINGER_DB_HOST',
#     'DB_NAME'        => 'YOUR_HOSTINGER_DB_NAME',
#     'DB_USER'        => 'YOUR_HOSTINGER_DB_USER',
#     'DB_PASS'        => 'YOUR_HOSTINGER_DB_PASSWORD',
#     'jwt_secret'     => 'a_new_random_64_char_string',
#     'GEMINI_API_KEY' => '',
#     'SMTP_PASSWORD'  => '',
# ];

# PayMongo (GCash / online bank) - read by app/helpers/payment_helper.php
PAYMENT_ENVIRONMENT=sandbox
PAYMONGO_SECRET_KEY=paymongo_sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYMONGO_WEBHOOK_SECRET=webhook_secret_xxxxxxxxxxxxxxxxxxxxxxxx

