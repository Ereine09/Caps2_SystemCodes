# Never execute uploaded files as scripts. Serve them as inert downloads/images only.
php_flag engine off
AddType application/octet-stream .php .php3 .php4 .php5 .php7 .phtml .pht .phar .cgi .pl .py .sh .htaccess

<FilesMatch "\.(php|php3|php4|php5|php7|phtml|pht|phar|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>
